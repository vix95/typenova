{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions",
  "windows": [
    "main",
    "doc-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:scope-appdata-recursive",
    "fs:allow-read-dir",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-remove"
  ]
}
